{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
